# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Product sources
# Keep private; never commit a real URL if it contains credentials.
OZON_FEED_URL=

# AI
# `none` keeps the deterministic pipeline only. Set `gemini` to enable the optional quality gate.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Gemini-specific aliases are also supported:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
