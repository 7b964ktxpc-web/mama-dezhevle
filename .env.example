# Product sources
# Keep private; never commit a real URL if it contains credentials.
OZON_FEED_URL=

# AI — optional/free-tier generation. If empty, deterministic local fallback is used.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CONTENT_AI_API_KEY=
CONTENT_AI_MODEL=gemini-3.5-flash-lite
