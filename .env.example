# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram — пользовательский бот
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Telegram — отдельный Content Bot
CONTENT_BOT_TOKEN=
CONTENT_ADMIN_CHAT_ID=
