# ===================================================================
# Мама, дешевле! — переменные окружения
# Скопируй в .env и заполни. Секреты (ключи/токены/URL с параметрами)
# никогда не коммить в репозиторий.
# ===================================================================

# --- Supabase (обязательно для всех job'ов) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Каталоги в формате YML (официальные фиды/партнёрские) ---
# Один фид:
CATALOG_YML_URL=
# Несколько фидов через запятую:
CATALOG_YML_URLS=
# Название источника для первого фида (опционально):
CATALOG_YML_SOURCE=

# --- Детский мир (публичный каталог распродаж) ---
DETMIR_PUBLIC_ENABLED=false
DETMIR_SOURCE_URL=

# --- Sima-land (официальный API v5) ---
SIMA_LAND_ENABLED=false
SIMA_LAND_API_KEY=
SIMA_LAND_PAGES=1
SIMA_LAND_ITEM_IDS=
SIMA_LAND_BABY_ONLY=true
SIMA_LAND_TIMEOUT_MS=10000
SIMA_LAND_RETRIES=2

# --- Ozon (XML/YML фид партнёрки) ---
OZON_FEED_URL=
# Альтернатива: публичный поиск (адаптер ozon-public, не подключён в registry)
OZON_SEARCH_URL=

# --- Ozon Partner API (витрина) — поиск по тексту, реальные цены ---
# Бесплатно на partner.ozon.ru. Работает как основной поиск бота, если заданы
# оба ключа. Цены приходят в копейках и делятся на 100.
OZON_PARTNER_CLIENT_ID=
OZON_PARTNER_API_KEY=

# --- AliExpress (YML фид) ---
ALIEXPRESS_YML_URL=

# --- Яндекс Маркет (партнёрский API поиска по тексту) ---
# Используется ботом для поиска реальных товаров с ценами.
YANDEX_MARKET_API_KEY=
YANDEX_MARKET_BUSINESS_ID=

# --- Яндекс Маркет (партнёрский API для редиректов/монетизации) ---
YANDEX_AFFILIATE_API_KEY=
YANDEX_AFFILIATE_PLACE_ID=
YANDEX_AFFILIATE_PRODUCT_URLS=

# --- Внешний парсер-поиск (web-parser-search) ---
PARSER_API_URL=
PARSER_API_TIMEOUT_MS=12000

# --- Распознавание товара по фото (OpenAI vision) ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# --- AI-фильтр качества (опционально, второй этап) ---
# AI_PROVIDER=none оставляет только детерминированный контур.
# Укажи gemini, чтобы включить проверку качества сделки.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Алиасы Gemini:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Публикация ---
# true — только подготовить тексты постов, без отправки в канал
PREVIEW_ONLY=false

# --- Тесты ---
TEST_TELEGRAM_CHAT_ID=
TEST_TELEGRAM_USER_ID=999999999

# --- Партнёрские ссылки и аналитика ---
# Публичный URL развёрнутого сайта (Next.js). Если задан, каталожные ссылки
# оборачиваются в /go?p=<id> для учёта кликов с редиректом на товар.
PUBLIC_SITE_URL=
# Шаблоны партнёрских ссылок по источнику. {url} заменяется на
# закодированный URL товара. Источники без шаблона сохраняют исходную ссылку.
# AFFILIATE_TEMPLATE_DETMIR=https://www.detmir.ru/products?url={url}&p=PARTNER_ID
# AFFILIATE_TEMPLATE_SIMALAND=https://www.sima-land.ru/{url}?ref=PARTNER_ID
# AFFILIATE_TEMPLATE_OZON=https://www.ozon.ru{url}?__ar_partner=PARTNER_ID
# AFFILIATE_TEMPLATE_ALIEXPRESS=https://aliexpress.com{url}?aff_trace_key=PARTNER_ID
# AFFILIATE_TEMPLATE_YANDEX_MARKET=https://market.yandex.ru{url}?rsrc=PARTNER_ID
